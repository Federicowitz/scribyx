        "data": {
          "title": "La chiave sotto il ponte",
          "content": {
            "type": "doc",
            "content": [
              { "type": "heading", "attrs": { "level": 1, "id": "chapter-ponte" }, "content": [{ "type": "text", "text": "Il ponte" }] },
              { "type": "paragraph", "attrs": { "id": "p-1" }, "content": [{ "type": "text", "text": "Mara e Nico trovano una chiave arrugginita sotto il ponte vecchio." }] },
              { "type": "paragraph", "attrs": { "id": "p-2" }, "content": [{ "type": "text", "text": "Sul manico c'e inciso un piccolo libro aperto." }] },
              { "type": "heading", "attrs": { "level": 1, "id": "chapter-archivio" }, "content": [{ "type": "text", "text": "L'archivio" }] },
              { "type": "paragraph", "attrs": { "id": "p-3" }, "content": [{ "type": "text", "text": "I due portano la chiave a Elia, il bibliotecario del paese." }] },
              { "type": "paragraph", "attrs": { "id": "p-4" }, "content": [{ "type": "text", "text": "Elia sorride e apre una porta nascosta dietro gli scaffali." }] }
            ]
          },
