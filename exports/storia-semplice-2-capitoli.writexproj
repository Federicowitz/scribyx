        "data": {
          "title": "La chiave sotto il ponte",
          "content": {
            "type": "doc",
            "content": [
              { "type": "heading", "attrs": { "level": 1, "id": "chapter-ponte" }, "content": [{ "type": "text", "text": "Il ponte" }] },
              { "type": "paragraph", "attrs": { "id": "p-1" }, "content": [
                { "type": "text", "text": "Mara", "marks": [{ "type": "entityLink", "attrs": { "linkId": "link-mara-1" } }] },
                { "type": "text", "text": " e " },
                { "type": "text", "text": "Nico", "marks": [{ "type": "entityLink", "attrs": { "linkId": "link-nico-1" } }] },
                { "type": "text", "text": " trovano una chiave arrugginita sotto il ponte vecchio." }
              ] },
              { "type": "paragraph", "attrs": { "id": "p-2" }, "content": [{ "type": "text", "text": "Sul manico c'e inciso un piccolo libro aperto." }] },
              { "type": "paragraph", "attrs": { "id": "p-3" }, "content": [{ "type": "text", "text": "Nessuno dei due sa a quale serratura possa appartenere." }] },
              { "type": "paragraph", "attrs": { "id": "p-4" }, "content": [{ "type": "text", "text": "Quando il sole cala, decidono di chiedere aiuto alla biblioteca." }] },
              { "type": "heading", "attrs": { "level": 1, "id": "chapter-archivio" }, "content": [{ "type": "text", "text": "L'archivio" }] },
              { "type": "paragraph", "attrs": { "id": "p-5" }, "content": [
                { "type": "text", "text": "Elia", "marks": [{ "type": "entityLink", "attrs": { "linkId": "link-elia-1" } }] },
                { "type": "text", "text": " guarda la chiave e smette subito di scherzare." }
              ] },
              { "type": "paragraph", "attrs": { "id": "p-6" }, "content": [
                { "type": "text", "text": "Conduce " },
                { "type": "text", "text": "Mara", "marks": [{ "type": "entityLink", "attrs": { "linkId": "link-mara-2" } }] },
                { "type": "text", "text": " e " },
                { "type": "text", "text": "Nico", "marks": [{ "type": "entityLink", "attrs": { "linkId": "link-nico-2" } }] },
                { "type": "text", "text": " davanti a uno scaffale di atlanti polverosi." }
              ] },
              { "type": "paragraph", "attrs": { "id": "p-7" }, "content": [{ "type": "text", "text": "La chiave apre una porticina bassa, nascosta dietro il legno." }] },
              { "type": "paragraph", "attrs": { "id": "p-8" }, "content": [
                { "type": "text", "text": "Dentro c'e l'archivio perduto del paese, e " },
                { "type": "text", "text": "Elia", "marks": [{ "type": "entityLink", "attrs": { "linkId": "link-elia-2" } }] },
                { "type": "text", "text": " ammette di aver aspettato qualcuno abbastanza curioso da trovarlo." }
              ] }
            ]
